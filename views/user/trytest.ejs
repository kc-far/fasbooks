//order pagination
<!-- Pagination Controls -->
                                <div class="pagination">
                                    <% if (currentPage > 1) { %>
                                        <a href="?page=<%= currentPage - 1 %>">Previous</a>
                                    <% } %>
            
                                    <% for (let i = 1; i <= totalPages; i++) { %>
                                        <a href="?page=<%= i %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
                                    <% } %>
            
                                    <% if (currentPage < totalPages) { %>
                                        <a href="?page=<%= currentPage + 1 %>">Next</a>
                                    <% } %>
                                </div>

//sortting by date
     <div class="dropdown">
    <button class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" 
            type="button" 
            data-bs-toggle="dropdown" 
            aria-expanded="false">
      
      <!-- Up & Down Arrow Icon (like Shift key) -->
      <span style="font-size: 1.1em; line-height: 1;">
        <i class="fas fa-angle-up text-primary"></i><br>
        <i class="fas fa-angle-down text-primary"></i>
      </span>

      <span class="fw-medium">
        <%= query.sort === 'oldest' ? 'Earliest' : 'Latest' %>
      </span>
    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow">
      <li>
        <a class="dropdown-item <%= query.sort !== 'oldest' ? 'active bg-light' : '' %>" 
   href="<%= buildUrl({ sort: 'newest' }) %>">
  Latest
</a>
      </li>
      <li>
        <a class="dropdown-item <%= query.sort === 'oldest' ? 'active bg-light' : '' %>" 
   href="<%= buildUrl({ sort: 'oldest' }) %>">
  Earliest
</a>
      </li>
    </ul>
  </div>


  //helper for search and sort
  <% 
// Safe & simple URL builder — NO req needed!
const buildUrl = (newParams = {}) => {
  const params = new URLSearchParams();
  if (search) params.set('search', search);
  if (currentPage && currentPage > 1) params.set('page', currentPage);

  Object.entries(newParams).forEach(([key, value]) => {
    if (value === null || value === undefined || value === '') {
      params.delete(key);
    } else {
      params.set(key, value);
    }
  });

  const query = params.toString();
  return `/admin/orders${query ? '?' + query : ''}`;
};
%>