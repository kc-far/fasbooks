<%- include("partials/header.ejs") %>
<link rel="stylesheet" href="/css/profileInfo.css"> 
<style>
  #editProfileModal  {
    margin-top: 95px;           /* navbar height + a little breathing room */
    z-index: 1080;              /* Bootstrap default = 1050; raise it */
    
}
</style>
    

  
  <div class="container  mx-auto px-4 py-8" id="container-main" >
    
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQtbEsykx-0fhTred6UwHDYtMFd2UgTJCG4gaklT1dx4suRO4_n5LJr4Gg28kquSX5fpNo&usqp=CAU" alt="Admin"
                        class="rounded-circle p-1 bg-warning" width="110">
                    <div class="mt-3">
                        <h4><%= user.name %></h4>
                        <p class="text-secondary mb-1"><%= user.email %></p>
                    </div>
                    <div class="list-group list-group-flush mt-4">
                        <a href="/profilePersonal" class="list-group-item list-group-item-action active text-center " onclick="showProfileDetails()">
                            Profile Information
                        </a>
                        <a href="/profileOrders" class="list-group-item list-group-item-action text-center" onclick="showOrderDetails()">
                            Orders
                        </a>
                        <a href="/profileAddress" class="list-group-item list-group-item-action text-center" onclick="showAddressBook()">
                            Address
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Details  -->
        <div class="col-md-8">
            <div id="profileDetails" class="card">
                <div class="card-body">
                    <div class="profile-info">
                        <h5 id="profilehead">About You</h5>
                        <p><strong>Name:</strong> <%= user.name %></p>
                        <p><strong>Email Address:</strong> <%= user.email %></p>
                        <% if (firstAddress) { %>
                            <p><strong>Contact:</strong> <%= firstAddress.phone || 'Not provided' %></p>
                            <p><strong>City:</strong> <%= firstAddress.city || 'Not provided' %></p>
                            <p><strong>State:</strong> <%= firstAddress.state || 'Not provided' %></p>
                        <% } else { %>
                            <p><strong>Contact:</strong> Not provided</p>
                            <p><strong>City:</strong> Not provided</p>
                            <p><strong>State:</strong> Not provided</p>
                        <% } %>
                        <p>
                            <strong>Referral Code:</strong>
                            <span id="referralCode"><%= user.referralCode %></span>
                            <button class="copy-btn btn btn-secondary btn-sm ml-2" onclick="copyReferralCode()" title="Copy Referral Code">
                                <i class="fas fa-copy"></i> Copy
                            </button>
                        </p>
                        <!-- <button id="edit-btn" class="btn btn-primary btn-sm mt-3"  onclick="toggleEditForm()">Edit Profile</button>-->
                         <button id="editProfileBtn"class="btn btn-primary btn-sm mt-3" data-toggle="modal" data-target="#editProfileModal">
                           Edit Profile</button>
                    </div> 

                    
                </div>
            </div> 

            <!-- ==== Edit Profile Modal ==== -->
<div class="modal fade" id="editProfileModal" tabindex="-1" role="dialog"
     aria-labelledby="editProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-dark" id="editProfileModalLabel">Edit Profile</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <form id="editProfileForm" action="/editProfile" method="POST">
                <div class="modal-body">

                    <div class="form-group">
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" class="form-control"
                               value="<%= user.name %>" required>
                        <small id="nameValidate" class="text-danger"></small>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control"
                               value="<%= user.email %>" required>
                        <small id="emailCheck" class="text-danger"></small>
                        <button type="button" class="btn btn-link p-0 ml-2" data-toggle="modal" data-target="#changeEmailModal">
                        Change Email</button>
                    </div>

                    <div class="form-group">
                        <label for="currentPassword">Current Password</label>
                        <input type="password" id="currentPassword" name="currentPassword"
                               class="form-control" placeholder="Enter current password" >
                        <small id="currentPassCheck" class="text-danger"></small>
                        <a href="/forgot-password" class="d-block mt-1">Forgot password?</a>
                    </div>

                    <div class="form-group">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" name="newPassword"
                               class="form-control" placeholder="Leave blank to keep the same">
                        <small id="newPassValidate" class="text-danger"></small>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               class="form-control" placeholder="Leave blank to keep the same">
                        <small id="confirmPass" class="text-success"></small>
                        <small id="changeSuccess" class="text-primary"></small>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
        </div> 
        <div class='card' id="area-link">
            <h4 class="text-dark text-center mt-3">Your Referral Link</h4>
            <p class="text-success ml-2 mt-2 ">Share this link with friends to earn rewards!</p>
            <% if (referralLink) { %>
                    <div class="input-group">
                        <input type="text" id="referralLink" class="form-control text-secondary" value="<%= referralLink %>" readonly>
                        <div class="input-group-append">
                            <button class="btn btn-primary ml-2 mr-2" onclick="copyToClipboard()" title="Copy Referral Link">
                                <i class="fas fa-copy"></i> Copy to Share
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <p class="text-danger text-center">Referral link not available.</p>
                <% } %>
        </div>
    </div>
  </div>
</section>




<script>
function copyReferralCode() {
    // Get the referral code text
    const referralCode = document.getElementById('referralCode').innerText;

    // Create a temporary input element to hold the text
    const tempInput = document.createElement('input');
    tempInput.value = referralCode;
    document.body.appendChild(tempInput);

    // Select and copy the text
    tempInput.select();
    tempInput.setSelectionRange(0, 99999); // For mobile devices
    navigator.clipboard.writeText(tempInput.value)
        .then(() => {
            // Show success feedback
            Swal.fire({
                icon: 'success',
                title: 'Copied!',
                text: 'Referral code copied to clipboard.',
                confirmButtonText: 'OK'
            });
        })
        .catch(err => {
            console.error('Error copying referral code:', err);
            Swal.fire({
                icon: 'error',
                title: 'Failed!',
                text: 'Unable to copy referral code.',
                confirmButtonText: 'OK'
            });
        });

    // Remove the temporary input element
    document.body.removeChild(tempInput);
}

function copyToClipboard(){
  const referralLink = document.getElementById('referralLink').value;
  if (referralLink) {
    navigator.clipboard.writeText(referralLink)
            .then(()=>{
               Swal.fire({
                icon: 'success',
                title: 'Copied!',
                text: 'Share to your Friends.',
                confirmButtonText: 'OK'
              });
            })
            .catch(err => {
              console.error('Error copying referral code:', err);
              Swal.fire({
                icon: 'error',
                title: 'Failed!',
                text: 'Unable to copy referralLink.',
                confirmButtonText: 'OK'
              });
            });
  } else {
       Swal.fire({
                icon: 'error',
                title: 'Failed!',
                text: 'No Refferral Link',
                confirmButtonText: 'OK'
        });
  }
}

function toggleEditForm() {
        const profileDetails = document.getElementById('profileDetails');
        const editProfileForm = document.getElementById('editProfileForm');
        // Toggle display between profile info and form
        const isFormVisible = editProfileForm.style.display === 'block';
        editProfileForm.style.display = isFormVisible ? 'none' : 'block';
    }
document.getElementById('editProfileForm').addEventListener('submit', function(e) {
    e.preventDefault();

    const name = document.getElementById('name').value.trim();
    const email = document.getElementById('email').value.trim();
    const currentPassword = document.getElementById('currentPassword').value.trim();
    const newPassword = document.getElementById('newPassword').value.trim();
    const confirmPassword = document.getElementById('confirmPassword').value.trim();

    // Clear previous validation messages
    document.getElementById('nameValidate').textContent = '';
    document.getElementById('emailCheck').textContent = '';
    document.getElementById('currentPassCheck').textContent = '';
    document.getElementById('newPassValidate').textContent = '';
    document.getElementById('confirmPass').textContent = '';
    document.getElementById('changeSuccess').textContent = '';

    if (!name) {
      document.getElementById('nameValidate').textContent = 'Name is required';
      return;
    }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(email)) {
      document.getElementById('emailCheck').textContent = 'Please enter a valid email';
      return;
    }
    if (newPassword&& !currentPassword) {
      document.getElementById('currentPassCheck').textContent = 'Current password is required';
      return;
    }
    if (newPassword && newPassword.length < 6) {
      document.getElementById('newPassValidate').textContent = 'New password must be at least 6 characters';
      return;
    }
    if (newPassword !== confirmPassword) {
        document.getElementById('confirmPass').textContent = 'Passwords do not match';
      return;
    }

    // Prepare data for submission
    const data = {
      name,
      email,
      currentPassword,
      newPassword: newPassword || undefined 
    };

    fetch('/editProfile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
      .then(response => response.json())
      .then(result => {
    if (result.success) {
    Swal.fire({
      icon: 'success',
      title: 'Profile Updated',
      text: 'Your profile has been updated successfully!',
      confirmButtonText: 'OK'
    }).then(() => {
      location.reload(); 
    });
  } else {
    
    Swal.fire({
      icon: 'error',
      title: 'Update Failed',
      text: result.error || 'Something went wrong. Please try again.',
      confirmButtonText: 'OK'
    }).then(() => {
      if (result.error === 'Invalid current password') {
        document.getElementById('currentPassCheck').textContent = 'Invalid current password';
      } else if (result.error === 'Email already in use') {
        document.getElementById('emailCheck').textContent = 'user with this email already exist';
      }
    });
  }
})
})

</script>



<%- include("partials/footer.ejs") %>
 