<div class="container py-5">
  <div class="card shadow-sm">
    <div class="card-header bg-light">
      <h4 class="font-weight-bold text-dark mb-0" id="orderModalLabel<%= order._id %>">
        Order Details
      </h4>
      <small class="text-muted">
        Placed on <%= order.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
      </small>
    </div>
    <div class="card-body">
      <div class="row">
        <!-- Main Order Details -->
        <div class="col-md-8">
          <div class="card border-0 mb-4">
            <div class="card-body p-0">
                 
              <!-- Order Status and Payment Method -->
              <div class="row mb-1 mr-3 ">
                <div class="col-md-6">
                  <h6 class="text-muted mb-2">Order Status:<span class="badge bg-<%= 
                                                    order.status === 'pending' ? 'warning' : 
                                                    order.status === 'delivered' ? 'success' : 
                                                    order.status === 'cancelled' ? 'danger' : 
                                                    order.status === 'shipped' ? 'primary' : 
                                                    order.status === 'returnRequested' ? 'info' : 
                                                    order.status === 'returned' ? 'secondary' : 
                                                    'danger' %>">
                                                    <%= order.status %></span>
                  </h6>
                  
                </div>
                <div class="col-md-6 text-right">
                  <h6 class="text-muted mb-2">Payment Method:<span class="font-weight-bold text-success">
                       <%= order.paymentMethod || 'Not Specified' %></span>
                  </h6>
                  
                </div>
              </div>
              <!-- Order Items -->
              <h5 class="mb-3">Order Items</h5>
              <div class="table-responsive">
                <table class="table table-borderless">
                  <tbody>
                    <% let subtotal = 0; let totalDiscount = 0; %>
                    <% order.items.forEach(function(item) { 
                      const itemPrice = item.priceAtOrder * item.quantity;
                      const itemDiscount = item.discount || 0;
                      const discountAmount = itemPrice * (itemDiscount / 100);
                      subtotal += itemPrice;
                      totalDiscount += discountAmount;
                    %>
                    <tr class="border-bottom">
                      <!-- Product Image + Clickable (Only if product exists) -->
                      <td class="align-middle p-2">
                        <% if (item.productId && item.productId.images && item.productId.images[0]) { %>
                          <img src="/<%= item.productId.images[0] %>"
                               alt="<%= item.titleAtOrder %>"
                               class="img-thumbnail mr-3"
                               style="width: 80px; height: 80px; object-fit: cover; cursor: pointer;"
                               onclick="window.location.href='/product-detail/<%= item.productId._id %>'"
                          />
                        <% } else { %>
                          <div style="width: 80px; height: 80px; background: #f0f0f0; border: 1px dashed #ccc; 
                          display: flex; align-items: center; justify-content: center; border-radius: 8px;">
                            <small class="text-muted">No Image</small>
                          </div>
                        <% } %>
                      </td>         
                      <td class="align-middle p-2">
                        <h6 class="mb-1">
                          <%= item.titleAtOrder || 'Unknown Product' %>
                          <% if (!item.productId) { %>
                            <span class="badge badge-secondary ml-2">Deleted</span>
                          <% } %>
                        </h6>
                        <small class="text-muted">
                          Qty: <%= item.quantity %> × ₹<%= item.priceAtOrder.toFixed(2) %>
                          <% if (itemDiscount > 0) { %>
                             | Discount: <%= itemDiscount %>%
                          <% } %>
                        </small>
                      </td>        
                      <td class="align-middle text-center">
                        <% if (order.status === 'returned') { %>
                          <span class="badge badge-success">Returned</span>
                        <% } else if (order.status === 'cancelled') { %>
                          <span class="badge badge-danger">Cancelled</span>
                        <% } else if (item.isCancelled) { %>
                          <span class="badge badge-danger">Item Cancelled</span>
                        <% } else if (item.isReturned) { %>
                          <span class="badge badge-success">Returned</span>
                        <% } %>
                      </td>
                      <% if (order.status === 'delivered' && !item.isReturned && !item.isCancelled && item.productId) { %>
                        <td class="align-middle text-center p-2">
                          <% if (item.returnStatus === 'requested') { %>
                            <button class="btn btn-warning btn-sm" disabled>
                            Return Requested</button>
                            <small class="d-block text-muted">Reason: <%= item.returnReason %></small>
                          <% } else { %>
                            <button class="btn btn-outline-danger btn-sm"
                                    onclick="showReturnForm('<%= order._id %>','<%= item.productId._id %>')">
                            Request Return </button>
                          <% } %>
                        </td>
                      <% } else { %>
                        <td class="align-middle text-center p-2">
                          <button class="btn btn-secondary btn-sm" disabled>Return Not Available</button>
                        </td>
                      <% } %>
                      <!-- Cancel Button -->
                      <% if ((order.status === 'pending' || order.status === 'paid') && 
                              order.paymentStatus !== 'failed' && !item.isCancelled && item.productId) { %>
                        <td class="align-middle text-center p-2">
                          <button class="btn btn-danger btn-sm"
                                  onclick="cancelItem('<%= order._id %>', '<%= item.productId._id %>')">
                          Cancel Item</button>
                        </td>
                      <% } else { %>
                        <td class="align-middle text-center p-2">
                          <button class="btn btn-secondary btn-sm" disabled>Cancel</button>
                        </td>
                      <% } %>
                    </tr>
                    <!-- Hidden Return Form -->
                    <% if (order.status === 'delivered' && !item.isReturned && !item.isCancelled && item.productId) { %>
                     
                      <tr id="return-form-<%= order._id %>_<%= item.productId._id %>" class="return-form" style="display: none;">
                        <td colspan="5" class="p-3 bg-light" style="width: max-content;">
                          <textarea class="form-control mb-2" 
                                    id="return-reason-<%= order._id %>_<%= item.productId._id %>" 
                                    rows="2" 
                                    placeholder="Please tell us why you want to return this item..."></textarea>
                          <button class="btn btn-success btn-sm" 
                                  onclick="submitReturnOrder('<%= order._id %>','<%= item.productId._id %>')">
                          Submit Request</button>
                          <button class="btn btn-secondary btn-sm" 
                                  onclick="hideReturnForm('<%= order._id %>','<%= item.productId._id %>')">
                          Cancel</button>
                        </td>
                      </tr>
                    <% }else if (item.returnStatus === 'requested') { %>
                      <td class="text-center">
                        <button class="btn btn-warning btn-sm" disabled>Return Requested</button>
                        <br><small class="text-muted d-block mt-1">Reason: <%= item.returnReason || 'N/A' %></small>
                      </td>
                    <% }else if (order.status !== 'delivered' || item.isReturned || item.isCancelled || !item.productId){ %>
                      <td class="text-center text-muted small">Return Not Available</td>
                    <%}%>
                  <% }) %>
                  </tbody>
                </table>
              </div>
                                     
 

               <!--Delivery Address and Summary -->
              <div class="row mt-3">
                <div class="col-md-6 p-2 ">
                  <h6 class="text-muted">Delivery Address</h6>
                  <p class="mb-1 ">
                    <strong><%= order.address.fullName %></strong><br />
                    <%= order.address.street %><br />
                    <%= order.address.city %>, <%= order.address.state %> <%= order.address.postalCode %><br />
                    <%= order.address.country %>
                  </p>
                </div>
                <div class="col-md-6 p-2 ">
                  <h6 class="text-muted ml-5">Order Summary</h6>
                  <p class="mb-1 ml-5">
                    Subtotal: <strong>₹<%= order.subtotal.toFixed(2) %></strong>
                  </p>
                  <p class=" mb-1 ml-5">
                    Discount: <strong>₹<%= order.discount.toFixed(2) %></strong>
                  </p>
                  <p class=" mb-1 ml-5">
                    Shipping: <strong>₹<%= order.shipping %></strong>
                  </p>

                  <h5 class="font-weight-bold text-primary ml-5">
                    Total: ₹<%= order.total.toFixed(2) %>
                  </h5>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Order Tracking -->
        <div class="col-md-4">
          <div class="card bg-light border-0">
            <div class="card-body">
              <h6 class="text-muted mb-3">Order Tracking</h6>
              <ul class="list-unstyled">
                <% const trackingStages = [
                  { stage: 'Order Placed', active: true },
                  { stage: 'Payment Confirmed', active: ['paid', 'shipped', 'delivered'].includes(order.status) },
                  { stage: 'Processing', active: ['shipped', 'delivered'].includes(order.status) },
                  { stage: 'Shipped', active: ['shipped', 'delivered'].includes(order.status) },
                  { stage: 'Delivered', active: order.status === 'delivered' }
                ] ;
                trackingStages.forEach((stage, index) => { %>
                <li class="mb-2 d-flex align-items-center">
                  <span class="mr-2 rounded-circle <%= stage.active ? 'bg-success' : 'bg-secondary' %>" style="width: 12px; height: 12px;"></span>
                  <%= stage.stage %>
                </li>
                <% }) %>
              </ul>
            </div>
          </div>
          <div class="border-top-0 mt-10">
      <% if (order.status === 'delivered') { %>
        <a href="/orders/<%= order._id %>/invoice" class="btn btn-outline-primary mr-auto" download>
          <i class="fas fa-file-invoice mr-2"></i>Download Invoice
        </a>
      <% } %>
      <a href="/profileOrders" class="btn btn-secondary">Back to Orders</a>
    </div>
        </div>
        
      </div>
    </div>
    
  </div>
  
  
</div>
