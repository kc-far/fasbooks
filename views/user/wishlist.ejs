<style>
.wishlist-table-container {
    padding: 15px 20px; /* Keep 15px top padding as requested */
    max-width: 1400px; /* Increased from 1200px to widen the container */
    margin: 0 auto;
}

.wishlist-table {
    width: 100%; /* Ensure table fills the container */
    border-collapse: collapse;
    background-color: #fff;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    overflow: hidden;
}

.wishlist-table th,
.wishlist-table td {
    padding: 25px; /* Keep height as is */
    text-align: left;
    border-bottom: 1px solid #ddd;
    vertical-align: middle;
}

.wishlist-table th {
    background-color: #f8f9fa;
    font-weight: 600;
    color: #333;
}

.wishlist-table td {
    vertical-align: middle;
}

.wishlist-table img {
    width: 140px; /* Wider image for more column width */
    height: 180px; /* Keep height */
    object-fit: cover;
    border-radius: 4px;
    transition: opacity 0.3s;
}

.wishlist-table img:hover {
    opacity: 0.9;
}

.wishlist-table .product-name a {
    color: #333;
    text-decoration: none;
    font-size: 1.1em;
    font-weight: 500;
    max-width: 300px;
    min-width: 400px; 
    display: inline-block;
    overflow: hidden;
    text-overflow: ellipsis;
    /* white-space: nowrap; */
}

.wishlist-table .product-name a:hover {
    color: #007bff;
}

.wishlist-table .product-price {
    font-size: 1em;
    font-weight: 600;
    color: #555;
    min-width: 200px; 
}

.wishlist-table .actions {
    /* display: flex; */
    gap: 15px;
    width: 350px;
}

.wishlist-table .btn {
    padding: 10px 18px; /* Keep button height */
    font-size: 0.9em;
    min-width: 120px; /* Wider buttons for actions column */
    text-align: center;
}

.wishlist-table .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
}

.wishlist-table .btn-danger {
    background-color: #dc3545;
    border-color: #dc3545;
}

.wishlist-table .btn:hover {
    opacity: 0.9;
}

/* Empty wishlist styling */
.empty-wishlist-message {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 1.2em;
}

/* Responsive design */
@media (max-width: 1400px) {
    .wishlist-table-container {
        max-width: 1200px; /* Scale down at larger breakpoint */
    }
    .wishlist-table img {
        width: 140px;
    }
    .wishlist-table .product-name a {
        max-width: 180px;
    }
    .wishlist-table .btn {
        min-width: 110px;
    }
}

@media (max-width: 992px) {
    .wishlist-table th,
    .wishlist-table td {
        padding: 18px;
    }
    .wishlist-table img {
        width: 120px;
    }
    .wishlist-table .product-name a {
        max-width: 150px;
    }
    .wishlist-table .btn {
        min-width: 100px;
        padding: 8px 15px;
    }
}

@media (max-width: 768px) {
    .wishlist-table th,
    .wishlist-table td {
        padding: 12px;
    }
    .wishlist-table img {
        width: 90px;
    }
    .wishlist-table .product-name a {
        max-width: 120px;
    }
    .wishlist-table .actions {
        flex-direction: column;
        gap: 5px;
    }
    .wishlist-table .btn {
        width: 100%;
    }
}
</style>

