<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<style>
    body {
        font-family: 'Poppins', sans-serif;
        color: #333;
        background-image: url('/images/ai-generated-illustration-staircase-books-covering-steps-side-banister-ai-generated-illustration-303054293.webp');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100vh;
    }
    .overlay {
        background-color: rgba(0, 0, 0, 0.5);
        height: 100vh;
    }
    .signup-container {
        background-color: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 100%;
    }
    .signup-title {
        font-weight: 600;
        color: #1a73e8;
        margin-bottom: 1.5rem;
    }
    .form-control {
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #e0e0e0;
        transition: all 0.3s;
    }
    .form-control:focus {
        border-color: #1a73e8;
        box-shadow: 0 0 0 2px rgba(26, 115, 232, 0.2);
    }
    .btn-primary {
        background-color: #1a73e8;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-weight: 500;
        transition: all 0.3s;
    }
    .btn-primary:hover {
        background-color: #1557b0;
    }
    .btn-primary:disabled {
        background-color: #b3d1ff;
        cursor: not-allowed;
    }
    .btn-link {
        color: #1a73e8;
        text-decoration: none;
    }
    .btn-link:hover {
        text-decoration: underline;
    }
    .btn-link:disabled {
        color: #b3d1ff;
        cursor: not-allowed;
    }
</style>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
        <h2 class="text-3xl font-bold mb-6 text-center text-gray-800">Verify OTP</h2>
        <form action="/verify-otp-forgot" method="POST">
            <div class="mb-4">
                <label for="otp" class="block text-sm font-medium text-gray-700 mb-2">Enter the OTP sent to your email:</label>
                <input type="text" id="otp" name="otp" required placeholder="Enter 6-digit OTP" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit" class="w-full bg-blue-500 text-white py-2 px-4 rounded-md hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors duration-300">
                Verify OTP
            </button>
            <div class="mt-4 flex items-center justify-between">
                <button type="button" id="resendOTPBtn" class="btn btn-link" disabled>Resend OTP</button>
                <div id="timerDisplay" class="text-sm text-gray-600"></div>
            </div>
        </form>
    </div>
     
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        let countdown = parseInt(localStorage.getItem('otpCountdown')) || 30;
        const timerDisplay = document.getElementById('timerDisplay');
        const resendButton = document.getElementById('resendOTPBtn');

        if (countdown > 0) {
                startTimer(); 
        } else {
                countdown = 30; 
                updateTimerDisplay(); 
                startTimer(); 
        
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(countdown / 30);
            const seconds = countdown % 30;
            timerDisplay.textContent = `Time remaining: ${minutes}:${seconds < 10 ? '0' : ''}${seconds} seconds`;
        }

        function startTimer() {
                resendButton.disabled = true; 
                const timer = setInterval(function () {
                    countdown--;
                    updateTimerDisplay();
                    localStorage.setItem('otpCountdown', countdown); 
    
                    if (countdown <= 0) {
                        clearInterval(timer);
                        countdown = 0;
                        updateTimerDisplay();
                        localStorage.removeItem('otpCountdown'); 
                        resendButton.disabled = false; 
                    }
                }, 1000);
            }

            resendButton.addEventListener('click', function () {
                const email = '<%= email %>'; 
                fetch('/resend-otp-forgot', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email }), 
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            icon:'success',
                            text:data.message
                        });
                        countdown = 30; 
                        updateTimerDisplay(); 
                        startTimer(); 
                    } else {
                        Swal.fire({
                            icon:'warning',
                            text:data.message
                        })
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error resending OTP. Please try again.');
                });
            });

    })
    </script>

    
</body>
</html>