<%- include("partials/header.ejs") %>
<link rel="stylesheet" href="/css/profile.css">
<link rel="stylesheet" href="/css/profileInfo.css">      
<div class="container  mx-auto px-4 py-8" id="container-main" >
    
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQtbEsykx-0fhTred6UwHDYtMFd2UgTJCG4gaklT1dx4suRO4_n5LJr4Gg28kquSX5fpNo&usqp=CAU" alt="Admin"
                        class="rounded-circle p-1 bg-warning" width="110">
                    <div class="mt-3">
                        <h4><%= user.name %></h4>
                        <p class="text-secondary mb-1"><%= user.email %></p>
                    </div>
                    <div class="list-group list-group-flush mt-4">
                        <a href="/profilePersonal" class="list-group-item list-group-item-action  text-center " onclick="showProfileDetails()">
                            Profile Information
                        </a>
                        <a href="/profileOrders" class="list-group-item list-group-item-action text-center active" onclick="showOrderDetails()">
                            Orders
                        </a>
                        <a href="/profileAddress" class="list-group-item list-group-item-action text-center " onclick="showAddressBook()">
                            Address
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
                        <div id="orderDetails" class="order_card">
                            <h5 class="mb-4">My Orders</h5>
                            <div class="mb-4">
    <input 
        type="text" 
        id="orderSearch" 
        class="form-control" 
        placeholder="Search by Order ID, Product Name, or Status..."
    >
</div>
                            <% if (orders.length > 0) { %>
                                <div class="order-list-container">
                                    <% orders.forEach(order => { %>
                                        <div class="card shadow-sm mb-4">
                                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                                <h2 class="mb-0">Order ID: <%= order.OrderId %></h2>
                                                <span class="badge bg-<%= 
                                                    order.status === 'pending' ? 'warning' : 
                                                    order.status === 'delivered' ? 'success' : 
                                                    order.status === 'cancelled' ? 'danger' : 
                                                    order.status === 'shipped' ? 'primary' : 
                                                    order.status === 'returnRequested' ? 'info' : 
                                                    order.status === 'returned' ? 'secondary' : 
                                                    'danger' %>">
                                                    <%= order.status %>
                                                </span>
                                            </div>
                                            
                                            <div class="card-body">
                                                
                                                <p><strong>Payment Status:</strong> 
                                                <span style="color: rgb(224, 85, 10); font-weight: bold;"><%= order.paymentStatus %></span>
                                                </p>
                                                <p><strong>Return Status:</strong> 
                                                <span style="color: rgb(255, 0, 140); font-weight: bold;"><%= order.returnStatus %></span>
                                                </p>
                                        
                                                <p><strong>Total Amount:</strong> ₹<%= order.total.toFixed(2) %></p>
                                                
                    
                                                <h6 class="mt-3">Products:</h6>
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-hover align-middle">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Image</th>
                                                                <th>Name</th>
                                                                <th>Quantity</th>
                                                                <th>Price</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% order.items.forEach(product => { %>
                                                                <tr>
                                                                    <td onclick="window.location.href='/product-detail/<%= product.productId._id %>'">
                                                                        <img src="<%= product.productId.images[0] %>" 
                                                                             alt="<%= product.productId.title%>" 
                                                                             class="img-thumbnail" 
                                                                             style="width: 50px; height: 50px; object-fit: cover;">
                                                                    </td>
                                                                    <td><%= product.productId.title||'Unnamed Product' %></td>
                                                                    <td><%= product.quantity %></td>
                                                                    <td>₹<%= product.priceAtOrder.toFixed(2) %></td>
                                                                </tr>
                                                            <% }) %>
                                                        </tbody>
                                                    </table>
                                                </div>
                                                
                                                <div>
                                                    <br>
                                                    <% if (order.paymentStatus === 'failed' && order.paymentMethod !== 'cod') { %>
                                                        <button class=" btn btn-primary retry-payment-btn btn-custom-padding" data-order-id="<%= order._id %>">Retry Payment</button>
                                                    <% } %>
                                                </div>
                                            </div>
                                            
                                          <div class="card-footer text-muted text-end">
                                                <a href="/orderDetails/<%= order._id %>" 
                                                    class="text-blue-600 hover:text-blue-800" >View Order Details</a>
                                            </div>
                                           
                                            
                                        </div>

                                    <% }) %>
                                
                                
                                </div>
                                
                                <nav>
                                    <ul class="pagination justify-content-center">
                                        <% for (let i = 1; i <= totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link" href="/profileOrders?page=<%= i %><%= search ? '&search=' + search : '' %>">
                                                    <%= i %>
                                                </a>
                                            </li>
                                        <% } %>
                                    </ul>
                                </nav>
                            <% } else { %>
                                <p class="text-muted">No orders found.</p>
                            <% } %>
                        </div>
                  </div>
    </div>
</div>
 <script>
document.getElementById('orderSearch').addEventListener('input', function () {
    let query = this.value.toLowerCase();
    document.querySelectorAll('.order-list-container .card').forEach(function (card) {
        let text = card.innerText.toLowerCase();
        card.style.display = text.includes(query) ? '' : 'none';
    });
});
</script>
<%- include("partials/footer.ejs") %>
 