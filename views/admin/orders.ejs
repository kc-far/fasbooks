                                                                    </button>
                                                                </div>
                                                                <div class="modal-body">
                                                                    <div class="row">
                                                                        <div class="col-md-4">
                                                                            <div class="card text-white bg-primary mb-3">
                                                                                <div class="card-header">
                                                                                    <h5>Customer Information</h5>
                                                                                </div>
                                                                                <div class="card-body">
                                                                                    <p><strong>Name:</strong> <%=order.userId ? order.userId.name:'N/A' %></p>
                                                                                    <p><strong>Email:</strong> <%=order.userId ? order.userId.email:'N/A' %></p>
                                                                                    <p><strong>Ordered Date:</strong> <%= order.createdAt.toLocaleDateString() %></p>
                                                                                    <p><strong>Delivery Status:</strong> 
                                                                                        <span class="badge badge-warning" style="font-size: 1.1em;"><%= order.status %></span>
                                                                                    </p>
                                                                                    <p><strong>Total Amount:</strong> ₹<%= order.total.toFixed(2) %></p>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                    
                                                                        <div class="col-md-4">
                                                                            <div class="card text-white bg-success mb-3">
                                                                                <div class="card-header">
                                                                                    <h5>Delivery Address</h5>
                                                                                </div>
                                                                                <div class="card-body">
                                                                                    <p><strong>Full Name:</strong> <%= order.address.fullName %></p>
                                                                                    <p><strong>Street:</strong> <%= order.address.street %></p>
                                                                                    <p><strong>City:</strong> <%= order.address.city %></p>
                                                                                    <p><strong>State:</strong> <%= order.address.state %></p>
                                                                                    <p><strong>Country:</strong> <%= order.address.country %></p>
                                                                                    <p><strong>Postal Code:</strong> <%= order.address.postalCode %></p>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                    
                                                                        <div class="col-md-4">
                                                                            <div class="card text-white bg-primary mb-3">
                                                                                <div class="card-header">
                                                                                    <h5>Items</h5>
                                                                                </div>
                                                                                <div class="card-body text-dark">
                                                                                    <ul class="list-group ">
                                                                                        <% order.items.forEach(function(item) { %>
                                                                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                                                                <div>
                                                                                                    <%= item.titleAtOrder %> x <%= item.quantity %> - ₹<%= item.priceAtOrder ? item.priceAtOrder.toFixed(2) : 'N/A' %>
                                                                                                    <% if (item.isCancelled) { %>
                                                                                                        <span class="badge badge-danger ml-2">Canceled</span>
                                                                                                    <% }else if(item.isReturned){ %>
                                                                                                        <span class="badge badge-danger ml-2">returned</span>
                                                                                                    <%}%>
                                                                                                </div>
                                                                                            </li>
                                                                                        <%})  %>
                                                                                    </ul>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                <% }) %>
                                            <% } else { %>
                                                <tr><td colspan="7">No orders found.</td></tr>
                                            <% } %>
                                        </tbody>
                                    </table>
                                    
                                </div>
            
                                <!-- Pagination -->
                                
<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="<%= buildUrl({ page: currentPage - 1 }) %>">Previous</a>
  <% } %>

  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="<%= buildUrl({ page: i }) %>"
       class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="<%= buildUrl({ page: currentPage + 1 }) %>">Next</a>
  <% } %>
</div>
            
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <%- include('partials/footer') %>
                </div>
            </div>
        
