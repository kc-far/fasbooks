                background-color: #f0f0f0;
                color: #333;
                text-decoration: none;
            }
        
            .pagination a.active {
                background-color: #007bff;
                color: white;
            }
        
            .pagination a:hover {
                background-color: #ddd;
            }
        </style>
        
    </div>
    <script src="/assets/vendors/js/vendor.bundle.base.js"></script>
    <script src="/assets/js/dashboard.js"></script>
    <script>
        function confirmStatusChange(selectElement) {
            const form = selectElement.closest('.order-status-form');
            const newStatus = selectElement.value;

            Swal.fire({
                title: 'Are you sure?',
                text: `Do you really want to change the status to "${newStatus}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, change it!',
                cancelButtonText: 'No, keep it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit(); // Submit the form if the user confirms
                } else {
                    selectElement.value = selectElement.options[0].value; // Reset to original value if canceled
                }
            });
        }
    </script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('orderSearch');
    const clearButton = document.querySelector('.search-form .btn-clear');
    const searchForm = searchInput.closest('form');

    const isOrderPage = window.location.pathname.includes('/admin/orders');
    if (isOrderPage) {
        // Pre-fill search input from URL
        const urlParams = new URLSearchParams(window.location.search);
        const searchQuery = urlParams.get('search');
        if (searchQuery) {
            searchInput.value = searchQuery;
            clearButton.style.display = 'inline-block';
        }
    }
    // Clear search when clicking clear button
    clearButton.addEventListener('click', function(e) {
        e.preventDefault();
        searchInput.value = '';
        this.style.display = 'none';
        searchForm.submit(); 
    });
})
 </script>  
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
