<% 
// Safe URL builder — preserves search, page, sort, status, paymentMethod
const buildUrl = (newParams = {}) => {
  const params = new URLSearchParams();
  
  // Keep existing filters
  if (search) params.set('search', search);
  if (currentPage && currentPage > 1) params.set('page', currentPage);
  if (query.sort) params.set('sort', query.sort);
  if (query.status && query.status !== 'all') params.set('status', query.status);
  if (query.paymentMethod && query.paymentMethod !== 'all') params.set('paymentMethod', query.paymentMethod);

  // Apply new changes
  Object.entries(newParams).forEach(([key, value]) => {
    if (value === null || value === undefined || value === 'all') {
      params.delete(key);
    } else {
      params.set(key, value);
    }
  });

  const q = params.toString();
  return `/admin/orders${q ? '?' + q : ''}`;
};
%>
