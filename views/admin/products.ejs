                                        <label for="editBookStock" class="form-label">Stock</label>
                                        <input type="number" class="form-control" id="editBookStock" name="stock" required step="0">
                                    </div>
                                
                                   <!-- existing image with remove option -->
                                   
                                        <div class="mb-3 d-flex flex-column gap-3" id="existingImages">
                                           

                                        </div>
                                   
                                     
                                    <!-- Upload New Images -->
                                    
<div class="mb-3">
  <label class="form-label">Upload New Images (Optional)</label>
  
  
              <div class="image-upload-grid">
                 <small id="imageLimitError" class="text-danger fs-6"></small>
              <div class="image-upload-container">
                <img src="" alt="" id="editImgView1" class="img-preview mb-2">
               
                <input class="form-control edit-image-input" type="file" name="eimages" id="eimg1" accept="image/png, image/jpeg, image/jpg" onchange="viewEditImage(event, 1)">
                <button type="button" class="btn btn-sm  mt-2"onclick="clearThisFile(this)">Cancel</button>
                <div class="cropper-container" style="display: none;">
                  <img id="editCroppedImg1" alt="Cropped Image">
                  <button type="button" id="editSaveButton1" class="btn btn-primary mt-2">Save Crop</button>
                  
                </div>
              </div>
              <div class="image-upload-container">
                <img src="" alt="" id="editImgView2" class="img-preview mb-2">
                <input class="form-control edit-image-input" type="file" name="eimages" id="eimg2" accept="image/png, image/jpeg, image/jpg" onchange="viewEditImage(event, 2)">
                <button type="button" class="btn btn-sm  mt-2"onclick="clearThisFile(this)">Cancel</button>
                <div class="cropper-container" style="display: none;">
                  <img id="editCroppedImg2" alt="Cropped Image">
                  <button type="button" id="editSaveButton2" class="btn btn-primary mt-2">Save Crop</button>
                </div>
              </div>
              <div class="image-upload-container">
                <img src="" alt="" id="editImgView3" class="img-preview mb-2">
                <input class="form-control edit-image-input" type="file" name="eimages" id="eimg3" accept="image/png, image/jpeg, image/jpg" onchange="viewEditImage(event, 3)">
                <button type="button" class="btn btn-sm  mt-2"onclick="clearThisFile(this)">Cancel</button>
                <div class="cropper-container" style="display: none;">
                  <img id="editCroppedImg3" alt="Cropped Image">
                  <button type="button" id="editSaveButton3" class="btn btn-primary mt-2">Save Crop</button>
                </div>
              </div>
            </div>
          
</div>
                                   
                                
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </form>
                        </div>
                    </div>
                </div>
                
