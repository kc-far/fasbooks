<script>

document.addEventListener('DOMContentLoaded', () => {
  
  const imagePreviewContainer = document.getElementById('image-preview-container');
  const imagePreviewsDiv = document.getElementById('imagePreviews');
  if (!imagePreviewsDiv && imagePreviewContainer) {
    console.error('Error: #imagePreviews element not found in the DOM');
    return;
  }

  
  let addCropperInstances = [];
  const createProductModal = document.getElementById('createProductModal');
  createProductModal.addEventListener('show.bs.modal', () => {
   
    addCropperInstances = [];
    if (imagePreviewContainer) imagePreviewContainer.style.display = 'none';
    if (imagePreviewsDiv) imagePreviewsDiv.innerHTML = '';                                                                                   
  });

  const addFileInputs = document.querySelectorAll('input[type="file"][name="eimages"]');
  
  addFileInputs.forEach((input, index) => {
    
    input.addEventListener('change', function (event) {
      
      const file = event.target.files[0];
      if (file) {
        
        const reader = new FileReader();
        reader.onload = (e) => {
          if (imagePreviewsDiv) imagePreviewsDiv.innerHTML = '';
          const img = document.createElement('img');
          img.src = e.target.result;
          img.style.maxWidth = '100%';
          img.id = `addImagePreview${index + 1}`;
          if (imagePreviewsDiv) imagePreviewsDiv.appendChild(img);
          img.onload = () => {
            
            if (addCropperInstances[index]) addCropperInstances[index].destroy();
            addCropperInstances[index] = new Cropper(img, {
              viewMode: 1,
              ready() {
                
                addCropperInstances[index] = this;
              }
            });
            if (imagePreviewContainer) imagePreviewContainer.style.display = 'block';
          };
          img.onerror = () => console.error('Error loading add image');
        };
        reader.onerror = () => console.error('Error reading add file');
        reader.readAsDataURL(file);
      }
    });
  });

  // Edit Product 
  const editProductModal = document.getElementById('editProductModal');
  let editCropperInstances = [];
  editProductModal.addEventListener('show.bs.modal', (event) => {
    
    const button = event.relatedTarget;
    const bookId = button.getAttribute('data-id');
    const bookTitle = button.getAttribute('data-title') || '';
    const bookAuthor = button.getAttribute('data-author') || '';
    const bookDescription = button.getAttribute('data-description') || '';
    const bookPrice = button.getAttribute('data-price') || '';
    const bookStock = button.getAttribute('data-stock') || '';
    const bookImages = JSON.parse(button.getAttribute('data-images') || '[]');
    

    document.getElementById('bookId').value = bookId;
    document.getElementById('editBookTitle').value = bookTitle;
    document.getElementById('editBookAuthor').value = bookAuthor;
    document.getElementById('editBookDescription').value = bookDescription;
    document.getElementById('editBookPrice').value = bookPrice;
    document.getElementById('editBookStock').value = bookStock;
    

    const existingImagesContainer = document.getElementById('existingImages');
    existingImagesContainer.innerHTML = '';
    existingImagesContainer.classList.add('d-flex', 'flex-column', 'gap-3');
    
    bookImages.forEach((image, index) => {
      existingImagesContainer.innerHTML += `
        <div data-index="${index}" style="width: 100%; max-width: 150px; position: relative;">
          <img src="/${image}" alt="Book Image ${index + 1}" style="width: 100%; height: auto; object-fit: cover;">
          <button type="button" onclick="removeImage('${bookId}', ${index})" class="btn btn-sm btn-dark" style="position: absolute; ">
            x
          </button>
        </div>`;
    });
    

    editCropperInstances = []; 
    
  });

  const editFileInputs = document.querySelectorAll('.edit-image-input');
  editFileInputs.forEach((input) => {
    
    input.addEventListener("change", (event) => {
      const index = input.id.replace("eimg", "");
      viewEditImage(event, index);
    });
  });

  //  form submission 
  const editBookForm = document.getElementById('editBookForm');
  editBookForm.addEventListener('submit', async function (event) {
    
    event.preventDefault();
    const formData = new FormData();
    
    formData.append('id', document.getElementById('bookId').value);
    formData.append('title', document.getElementById('editBookTitle').value);
    formData.append('author', document.getElementById('editBookAuthor').value);
    formData.append('description', document.getElementById('editBookDescription').value);
    formData.append('price', document.getElementById('editBookPrice').value);
    formData.append('stock', document.getElementById('editBookStock').value);
    

    editFileInputs.forEach((input, index) => {
      if (input.files.length > 0) {
        
        formData.append('images', input.files[0]);
      }
    });   
    try {
      
      const response = await fetch('/admin/editBooks', { method: 'POST', body: formData });
      
      if (response.ok) {
        
        Swal.fire({
          icon: 'success', title: 'Success!', text: 'Book updated successfully!', confirmButtonColor: '#3085d6'
        }).then(() => location.reload());
      } else {
        const errorText = await response.text();
        if (response.status === 409) {
          Swal.fire({ icon: 'warning', title: 'Duplicate Entry', text: 'A book with this name already exists.', confirmButtonColor: '#d33' });
        } else {
          Swal.fire({ icon: 'error', title: 'Oops!', text: errorText || 'Error updating book.', confirmButtonColor: '#d33' });
        }
       
      }
    } catch (err) {
      console.error('Fetch error:', err);
      Swal.fire({ icon: 'error', title: 'Oops!', text: 'Network error occurred.', confirmButtonColor: '#d33' });
    }
  });
  document.getElementById('editProductModal').addEventListener('show.bs.modal', function (event) {
  const button = event.relatedTarget;
  const imageCount = parseInt(button.getAttribute('data-images-count')) || 0;
  const fileInputs = document.querySelectorAll('input[name="eimages"]');
  const error=document.getElementById('imageLimitError')

  if (imageCount >= 4) {
    fileInputs.forEach(input => {
      input.disabled = true;
      error.textContent='Maximum image limit reached,Remove existing one to add new one'
    });
  }else{
    fileInputs.forEach(input => {
      input.disabled = false;
      input.style.display = 'block';
      error.textContent=''
    });
  }
})

 
});
//for view image
function viewEditImage(event, index) {
    
    const input = event.target;
    const reader = new FileReader();
    reader.onload = function () {
      
      const dataURL = reader.result;
      const image = document.getElementById("editImgView" + index);
      image.src = dataURL;

      const cropper = new Cropper(image, {
        aspectRatio: 4 / 6, // Rectangular ratio
        cropBoxResizable: true, 
        cropBoxWidth: 300, 
        cropBoxHeight: 600, 
        guides: true,
        background: false,
        autoCropArea: 1,
        zoomable: true,
      });

      const cropperContainer = document.querySelector("#editCroppedImg" + index).parentNode;
      cropperContainer.style.display = "block";
      

      const saveButton = document.querySelector("#editSaveButton" + index);
      saveButton.addEventListener("click", async function () {
        
        const croppedCanvas = cropper.getCroppedCanvas({
          width: 300, //  output width
          height: 225 
        });
        const croppedImage = document.getElementById("editCroppedImg" + index);
        croppedImage.src = croppedCanvas.toDataURL("image/jpeg", 1.0);

        const timestamp = new Date().getTime();
        const fileName = `cropped-img-${timestamp}-${index}.png`;

        await croppedCanvas.toBlob((blob) => {
          
          const input = document.getElementById("eimg" + index);
          const imgFile = new File([blob], fileName, { type: "image/png" });

          const fileList = new DataTransfer();
          fileList.items.add(imgFile);
          input.files = fileList.files;
        });

        cropperContainer.style.display = "none";
        cropper.destroy();
        
      });
    };
    reader.onerror = function () {
      console.error('Error reading edit file');
    };
    
    reader.readAsDataURL(input.files[0]);
}
//remove image script
function removeImage(bookId, index) {
    Swal.fire({
      title: 'Remove image?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33', confirmButtonText: 'Yes', background: '#000', color: '#fff',
    }).then((result) => {
      if (result.isConfirmed) {
        fetch('/admin/remove-image', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ bookId, index }),
        })
          .then(response => response.json())
          .then(data => { 
            if (data.success){
              
              const existingImagesContainer = document.getElementById('existingImages');
              const imageDiv = existingImagesContainer.querySelector(`div[data-index="${index}"]`);
              const error=document.getElementById('imageLimitError')
              if (imageDiv) imageDiv.remove();
              document.querySelectorAll('input[name="eimages"]').forEach(input => {
                input.disabled = false;
                error.textContent=''
              });
             
            }  
            else throw new Error(data.error || 'Failed to remove image'); })
          .catch(error => {
            console.error('Error:', error);
            Swal.fire({ icon: 'error', title: 'Error', text: error.message, confirmButtonColor: '#d33', background: '#000', color: '#fff' });
          });
      }
    });
}
//cancel selected file
function clearThisFile(button) {
  const container = button.closest('.image-upload-container');
  const input = container.querySelector('input[type="file"]');
  const preview = container.querySelector('img');

  input.value = "";           
  if (preview) {
    preview.src = "";
    preview.style.display = 'none';
  }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>   
<script>
        function confirmDeleteBook(event,message,form) {
            event.preventDefault(); // Prevent the form from submitting immediately
        
            // Show SweetAlert confirmation dialog
            Swal.fire({
                title: 'Are you sure?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes',
                cancelButtonText: 'No, cancel',
                background: '#000',  
                color: '#fff'           
            }).then((result) => {
                if (result.isConfirmed) {
                    const button = form.querySelector('button');
                     button.classList.remove('btn-success', 'btn-danger');
                     button.classList.add('btn-secondary'); 
                        
                    // Submit the form if the user confirms
                     form.submit();
                }
            });
        
            return false;  
        }
</script>
